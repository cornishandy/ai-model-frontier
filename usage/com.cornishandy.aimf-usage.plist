<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.cornishandy.aimf-usage</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>__REPO_PATH__/usage/collect.mjs</string>
    <string>--publish</string>
    <string>--quiet</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO_PATH__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AIMF_USAGE_GH</key><string>/opt/homebrew/bin/gh</string>
    <key>PATH</key><string>/usr/bin:/bin</string>
  </dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/aimf-usage.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/aimf-usage.log</string>
</dict>
</plist>
